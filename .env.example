# Store real credentials in Vercel environment settings or an ignored .env.local.
DATABASE_URL=
APP_URL=
NEXT_PUBLIC_APP_URL=

# Production dashboard and management API use HTTP Basic Auth and fail closed
# unless both values are set. Password must be at least 32 UTF-8 bytes; use a
# separate, strong random value.
OPERATOR_USERNAME=
OPERATOR_PASSWORD=

# Vercel supplies this separate value to cron as a Bearer token.
CRON_SECRET=

# Optional independent CT-discovery fallback. Supply an API key/plan licensed
# for commercial use; it is queried only when crt.sh cannot fill the batch.
CTLOGS_API_KEY=

# Preview management and provider mutations are disabled by default. Enable only
# after Preview has its own isolated database, never the production database.
ALLOW_PREVIEW_OPERATIONS=false

# Use test mode first, and a separate database for test/preview deployments.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Bootstrap defaults for a NEW database. Saved dashboard configuration wins after
# initialization. Setting AUTONOMOUS_ENABLED=false is also a runtime kill switch.
# Set true in Production to enable daily cron without opening the dashboard.
AUTONOMOUS_ENABLED=
AUTONOMOUS_CREATE_CHECKOUT=false
AUTONOMOUS_SEND_OUTREACH=false

RESEND_API_KEY=
FROM_EMAIL=
OUTREACH_REPLY_TO=
RESEND_WEBHOOK_SECRET=
REVENUE_ALERT_EMAIL=
OUTREACH_POSTAL_ADDRESS=
# Explicitly confirm a monitored reply/opt-out mailbox and real business address.
# This is separate from autonomous outreach authorization and Resend verification.
OUTREACH_COMPLIANCE_CONFIRMED=false
# Test-mode email never goes to a prospect; it requires this operator-owned inbox.
OUTREACH_TEST_RECIPIENT=

# Optional local examples only; never seeded on Vercel or sent automatically.
SEED_DEMO_DATA=false
